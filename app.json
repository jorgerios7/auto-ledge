{
  "expo": {
    "name": "Auto Ledge",
    "slug": "auto-ledge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#0F3D5E"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jar.autoledge",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F3D5E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Este aplicativo precisa de acesso ao Bluetooth para conectar ao adaptador OBD2."
        }
      ],
      [
        "with-rn-bluetooth-classic",
        {
          "peripheralUsageDescription": "Este aplicativo precisa de acesso ao Bluetooth para conectar ao adaptador OBD2.",
          "alwaysUsageDescription": "Este aplicativo precisa de acesso ao Bluetooth para conectar ao adaptador OBD2."
        }
      ],
      "expo-system-ui"
    ]
  }
}
